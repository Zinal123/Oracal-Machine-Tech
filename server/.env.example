# Hostinger Mail API bearer token (hPanel > Emails > your mailbox > API).
# Never commit the real value — copy this file to .env and fill it in there.
HOSTINGER_MAIL_API_TOKEN=

# Mailbox the token is authorized for, and where quote requests are delivered.
MAIL_ADDRESS=info@oraclemachinetech.com

# Comma-separated list of origins allowed to call this API (your site's domain(s)).
FRONTEND_ORIGIN=https://oraclemachinetech.com,https://www.oraclemachinetech.com

# Port the server listens on (the Hostinger Node.js app panel usually sets this for you).
PORT=3000
